# Required for LLM style blending (optional - falls back to deterministic mapping)
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# CORS origins (JSON list of allowed frontend URLs)
# Default: ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# Server port (Railway injects this automatically)
PORT=8000

# Render settings
RENDER_DIR=data/renders
RENDER_TTL_SECONDS=3600
MAX_WORKERS=1

# ChromaDB settings
CHROMA_PERSIST_DIR=data/chroma
